# All optional. Copy to server/.env; `npm run dev` loads it if present.
PORT=4000
# ":memory:" (default) reseeds on every start; use a file path to keep data between restarts.
DATABASE_PATH=:memory:
SESSION_IDLE_MINUTES=30
# ChatGPT is used when this is set. Leave it empty in the example. Put the real key only in server/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Used only when OPENAI_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
